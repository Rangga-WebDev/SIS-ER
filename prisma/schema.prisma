generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DOSEN
  ADMIN
  OPERATOR
  TIM_PAK
  KOMITE_INTEGRITAS_AKADEMIK
  TIM_SENAT
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum DocumentStatus {
  NOT_UPLOADED
  PENDING
  VALID
  REVISION
  REJECTED
}

enum RequirementAudience {
  DOSEN
  ADMIN
  BOTH
}

enum DocumentInputType {
  FILE
  URL
  FILE_AND_URL
  METADATA_ONLY
}

enum NotificationType {
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_REVISION
  DOCUMENT_REJECTED
  SYSTEM
}

enum DupakStatus {
  DRAFT
  SUBMITTED
  REVISION
  APPROVED
  REJECTED
  PERLU_PERBAIKAN_ADMIN
  DITOLAK_ADMIN
  LOLOS_VERIFIKASI_ADMIN
  DITUGASKAN_KE_TIM_PAK
  SEDANG_DINILAI
  PERLU_REVISI_TIM_PAK
  DIKIRIM_ULANG_SETELAH_REVISI
  DITERIMA_TIM_PAK
  PENILAIAN_DISAHKAN
  BERITA_ACARA_DRAFT
  BERITA_ACARA_DISAHKAN
  PEMERIKSAAN_INTEGRITAS
  PEMERIKSAAN_SENAT
  SELESAI
}

enum VerificationDecision {
  LOLOS_VERIFIKASI
  PERLU_PERBAIKAN_ADMIN
  DITOLAK_ADMIN
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  REASSIGNED
}

enum AssessmentDecision {
  PERLU_REVISI
  DITERIMA
}

enum MinuteStatus {
  DRAFT
  FINAL
}

enum IntegrityResult {
  MEMENUHI
  PERLU_KLARIFIKASI
  PERLU_PERBAIKAN
  TIDAK_MEMENUHI
}

enum SenateDecision {
  DISETUJUI
  DIKEMBALIKAN
}

// Status penilaian per item/sub-item oleh Tim PAK.
// Tidak ada baris review = Belum Dinilai.
enum DupakReviewStatus {
  SESUAI
  PERLU_REVISI
  TIDAK_SESUAI
  DIREVISI_DOSEN
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(DOSEN)
  status       AccountStatus @default(ACTIVE)

  // Dinaikkan saat reset password untuk mencabut seluruh sesi JWT lama.
  tokenVersion Int @default(0)

  lecturerProfile LecturerProfile?
  activityLogs     ActivityLog[]
  notifications   Notification[]
  pakAssignments  PakAssignment[] @relation("PakAssignmentAssessor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model LecturerProfile {
  id                 String @id @default(cuid())
  nidnOrNuptk        String @unique
  firstName          String
  lastName           String
  fullName           String
  phone              String?
  institution        String
  faculty            String?
  studyProgram       String
  academicPosition   String
  lecturerStatus     String
  profileStatus      String @default("BELUM_LENGKAP")
  documentStatus     String @default("BELUM_UPLOAD")
  verificationStatus String @default("MENUNGGU_DATA")

  photoFileName    String?
  photoFileSize    Int?
  photoMimeType    String?
  photoStoragePath String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  submissions      DocumentSubmission[]
  dupakSubmissions DupakSubmission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([studyProgram])
}

model DocumentCategory {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String?
  order       Int    @default(0)

  requirements DocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model DocumentRequirement {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String?

  audience   RequirementAudience @default(DOSEN)
  inputType  DocumentInputType   @default(FILE)
  isRequired Boolean             @default(true)

  maxSizeMb        Int      @default(5)
  allowedMimeTypes String[] @default(["application/pdf", "image/jpeg", "image/png"])

  order Int @default(0)

  isYearly Boolean @default(false)
  yearStart Int?
  yearEnd   Int?

  requiresLetterNumber Boolean @default(false)
  requiresLetterDate   Boolean @default(false)
  requiresExternalUrl  Boolean @default(false)

  helperText String?
  sampleUrl  String?

  categoryId String
  category   DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  submissions DocumentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([audience])
  @@index([inputType])
  @@index([isYearly])
}

model DocumentSubmission {
  id     String         @id @default(cuid())
  status DocumentStatus @default(PENDING)

  adminNote String?

  fileName    String?
  fileSize    Int?
  mimeType    String?
  storagePath String?

  versionNumber Int @default(1)

  academicYear Int?
  occurrenceKey String @default("default")

  externalUrl  String?
  letterNumber String?
  letterDate   DateTime?
  skpPredicate String?

  metadata Json?

  lecturerId String
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  requirementId String
  requirement   DocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  verificationLogs VerificationLog[]
  versions         DocumentVersion[]

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([lecturerId, requirementId, occurrenceKey])
  @@index([status])
  @@index([lecturerId])
  @@index([requirementId])
  @@index([academicYear])
}

model DocumentVersion {
  id            String @id @default(cuid())
  versionNumber Int

  fileName    String?
  fileSize    Int?
  mimeType    String?
  storagePath String?

  academicYear Int?
  externalUrl  String?
  letterNumber String?
  letterDate   DateTime?
  skpPredicate String?

  metadata Json?

  uploaderId    String?
  uploaderEmail String?

  submissionId String
  submission   DocumentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
  @@index([versionNumber])
  @@index([createdAt])
}

model VerificationLog {
  id            String         @id @default(cuid())
  status        DocumentStatus
  note          String?
  reviewerId    String?
  reviewerEmail String?

  submissionId String
  submission   DocumentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([status])
}

model ActivityLog {
  id       String  @id @default(cuid())
  action   String
  entity   String?
  entityId String?
  metadata Json?

  actorId String?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

model Notification {
  id      String           @id @default(cuid())
  title   String
  message String
  type    NotificationType @default(SYSTEM)
  href    String?

  isRead Boolean @default(false)
  metadata Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model DupakSubmission {
  id String @id @default(cuid())

  nomor String?
  instansi String?
  masaPenilaianStart DateTime?
  masaPenilaianEnd   DateTime?

  personalData Json?
  creditData   Json?

  supportNotes String?

  status            DupakStatus @default(DRAFT)
  currentStep       Int         @default(1)
  completionPercent Int         @default(0)

  adminNote String?

  lecturerId String          @unique
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  evidences DupakEvidence[]

  adminVerifications AdminVerification[]
  pakAssignments     PakAssignment[]
  examinationMinute  ExaminationMinute?
  integrityReviews   IntegrityReview[]
  senateReviews      SenateReview[]
  statusHistories    StatusHistory[]
  itemEntries        DupakItemEntry[]
  itemReviews        DupakItemReview[]
  reviewHistories    DupakReviewHistory[]

  submittedAt DateTime?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lecturerId])
  @@index([completionPercent])
}

model DupakEvidence {
  id String @id @default(cuid())

  rowCode  String
  rowLabel String

  evidenceUrl String?

  fileName    String?
  fileSize    Int?
  mimeType    String?
  storagePath String?

  note String?

  uploaderId    String?
  uploaderEmail String?

  dupakSubmissionId String
  dupakSubmission   DupakSubmission @relation(fields: [dupakSubmissionId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dupakSubmissionId])
  @@index([rowCode])
  @@index([mimeType])
  @@index([uploadedAt])
}

model AdminVerification {
  id String @id @default(cuid())

  decision     VerificationDecision
  internalNote String?
  lecturerNote String?

  submissionId String
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  adminId    String?
  adminEmail String?

  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([submissionId])
  @@index([decision])
}

model PakAssignment {
  id String @id @default(cuid())

  status AssignmentStatus @default(ACTIVE)

  submissionId String
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  pakUserId String
  pakUser   User   @relation("PakAssignmentAssessor", fields: [pakUserId], references: [id], onDelete: Cascade)

  assignedById    String?
  assignedByEmail String?

  assignedAt     DateTime  @default(now())
  deadline       DateTime?
  assignmentNote String?

  reassignedFromId String?

  cancelledAt        DateTime?
  cancellationReason String?

  assessment  PakAssessment?
  itemReviews DupakItemReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, pakUserId, status])
  @@index([submissionId])
  @@index([pakUserId])
  @@index([status])
  @@index([deadline])
}

model PakAssessment {
  id String @id @default(cuid())

  assignmentId String        @unique
  assignment   PakAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  assessorId    String?
  assessorEmail String?

  decision   AssessmentDecision?
  totalScore Float?

  internalNote         String?
  lecturerRevisionNote String?

  isRatified Boolean   @default(false)
  ratifiedAt DateTime?
  lockedAt   DateTime?

  reopenedAt   DateTime?
  reopenReason String?

  // Posisi item terakhir yang dibuka penilai (rowCode::entryKey) agar dapat dilanjutkan.
  lastPosition String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([decision])
  @@index([isRatified])
}

// Rincian kegiatan (sub-item) yang diinput dosen pada satu baris DUPAK.
// Contoh: daftar artikel jurnal pada baris "Karya ilmiah jurnal internasional".
model DupakItemEntry {
  id String @id @default(cuid())

  submissionId String
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  rowCode String

  title        String
  subCategory  String?
  description  String?
  activityYear String?

  // Angka kredit per rincian, disimpan sebagai string desimal (koma/titik).
  credit String?

  evidenceUrl String?

  orderIndex Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId, rowCode])
  @@index([submissionId])
}

// Penilaian Tim PAK per item / per rincian.
// entryKey "" = penilaian level baris; selain itu berisi id DupakItemEntry.
model DupakItemReview {
  id String @id @default(cuid())

  submissionId String
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  assignmentId String
  assignment   PakAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  rowCode  String
  entryKey String @default("")

  assessedCredit String?
  status         DupakReviewStatus?
  comment        String?

  assessorId    String?
  assessorEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, rowCode, entryKey])
  @@index([submissionId, rowCode])
  @@index([assignmentId])
  @@index([status])
}

// Jejak historis perubahan rincian/penilaian (append-only, tidak pernah dihapus).
model DupakReviewHistory {
  id String @id @default(cuid())

  submissionId String
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  assignmentId String?

  rowCode  String
  entryKey String @default("")

  // "ASSESSMENT" = snapshot penilaian sebelum berubah, "ENTRY" = snapshot rincian dosen.
  kind String

  snapshot Json

  reason     String?
  actorEmail String?
  actorRole  String?

  createdAt DateTime @default(now())

  @@index([submissionId, rowCode])
  @@index([assignmentId])
  @@index([createdAt])
}

model ExaminationMinute {
  id String @id @default(cuid())

  nomor           String?
  examinationDate DateTime?

  content Json?

  status MinuteStatus @default(DRAFT)

  submissionId String          @unique
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdById    String?
  createdByEmail String?

  ratifiedAt   DateTime?
  lockedAt     DateTime?
  reopenedAt   DateTime?
  reopenReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model IntegrityReview {
  id String @id @default(cuid())

  result IntegrityResult
  note   String?

  submissionId String
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reviewerId    String?
  reviewerEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([result])
}

model SenateReview {
  id String @id @default(cuid())

  decision SenateDecision
  note     String?

  submissionId String
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reviewerId    String?
  reviewerEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([decision])
}

model StatusHistory {
  id String @id @default(cuid())

  fromStatus DupakStatus?
  toStatus   DupakStatus

  reason String?

  submissionId String
  submission   DupakSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  changedById    String?
  changedByEmail String?
  changedByRole  String?

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([toStatus])
  @@index([createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
