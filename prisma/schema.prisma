generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DOSEN
  ADMIN
  OPERATOR
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum DocumentStatus {
  NOT_UPLOADED
  PENDING
  VALID
  REVISION
  REJECTED
}

enum RequirementAudience {
  DOSEN
  ADMIN
  BOTH
}

enum DocumentInputType {
  FILE
  URL
  FILE_AND_URL
  METADATA_ONLY
}

enum NotificationType {
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_REVISION
  DOCUMENT_REJECTED
  SYSTEM
}

enum DupakStatus {
  DRAFT
  SUBMITTED
  REVISION
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(DOSEN)
  status       AccountStatus @default(ACTIVE)

  lecturerProfile LecturerProfile?
  activityLogs     ActivityLog[]
  notifications   Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model LecturerProfile {
  id                 String @id @default(cuid())
  nidnOrNuptk        String @unique
  firstName          String
  lastName           String
  fullName           String
  phone              String?
  institution        String
  faculty            String?
  studyProgram       String
  academicPosition   String
  lecturerStatus     String
  profileStatus      String @default("BELUM_LENGKAP")
  documentStatus     String @default("BELUM_UPLOAD")
  verificationStatus String @default("MENUNGGU_DATA")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  submissions      DocumentSubmission[]
  dupakSubmissions DupakSubmission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([studyProgram])
}

model DocumentCategory {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String?
  order       Int    @default(0)

  requirements DocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model DocumentRequirement {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String?

  audience   RequirementAudience @default(DOSEN)
  inputType  DocumentInputType   @default(FILE)
  isRequired Boolean             @default(true)

  maxSizeMb        Int      @default(5)
  allowedMimeTypes String[] @default(["application/pdf", "image/jpeg", "image/png"])

  order Int @default(0)

  isYearly Boolean @default(false)
  yearStart Int?
  yearEnd   Int?

  requiresLetterNumber Boolean @default(false)
  requiresLetterDate   Boolean @default(false)
  requiresExternalUrl  Boolean @default(false)

  helperText String?
  sampleUrl  String?

  categoryId String
  category   DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  submissions DocumentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([audience])
  @@index([inputType])
  @@index([isYearly])
}

model DocumentSubmission {
  id     String         @id @default(cuid())
  status DocumentStatus @default(PENDING)

  adminNote String?

  fileName    String?
  fileSize    Int?
  mimeType    String?
  storagePath String?

  versionNumber Int @default(1)

  academicYear Int?
  occurrenceKey String @default("default")

  externalUrl  String?
  letterNumber String?
  letterDate   DateTime?
  skpPredicate String?

  metadata Json?

  lecturerId String
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  requirementId String
  requirement   DocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  verificationLogs VerificationLog[]
  versions         DocumentVersion[]

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([lecturerId, requirementId, occurrenceKey])
  @@index([status])
  @@index([lecturerId])
  @@index([requirementId])
  @@index([academicYear])
}

model DocumentVersion {
  id            String @id @default(cuid())
  versionNumber Int

  fileName    String?
  fileSize    Int?
  mimeType    String?
  storagePath String?

  academicYear Int?
  externalUrl  String?
  letterNumber String?
  letterDate   DateTime?
  skpPredicate String?

  metadata Json?

  uploaderId    String?
  uploaderEmail String?

  submissionId String
  submission   DocumentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([submissionId, versionNumber])
  @@index([submissionId])
  @@index([versionNumber])
  @@index([createdAt])
}

model VerificationLog {
  id            String         @id @default(cuid())
  status        DocumentStatus
  note          String?
  reviewerId    String?
  reviewerEmail String?

  submissionId String
  submission   DocumentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([status])
}

model ActivityLog {
  id       String  @id @default(cuid())
  action   String
  entity   String?
  entityId String?
  metadata Json?

  actorId String?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

model Notification {
  id      String           @id @default(cuid())
  title   String
  message String
  type    NotificationType @default(SYSTEM)
  href    String?

  isRead Boolean @default(false)
  metadata Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model DupakSubmission {
  id String @id @default(cuid())

  nomor String?
  instansi String?
  masaPenilaianStart DateTime?
  masaPenilaianEnd   DateTime?

  personalData Json?
  creditData   Json?

  supportNotes String?

  status            DupakStatus @default(DRAFT)
  currentStep       Int         @default(1)
  completionPercent Int         @default(0)

  adminNote String?

  lecturerId String          @unique
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  evidences DupakEvidence[]

  submittedAt DateTime?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lecturerId])
  @@index([completionPercent])
}

model DupakEvidence {
  id String @id @default(cuid())

  rowCode  String
  rowLabel String

  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String

  note String?

  uploaderId    String?
  uploaderEmail String?

  dupakSubmissionId String
  dupakSubmission   DupakSubmission @relation(fields: [dupakSubmissionId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dupakSubmissionId])
  @@index([rowCode])
  @@index([mimeType])
  @@index([uploadedAt])
}
